{
  "name": "nralam-portfolio",
  "private": true,
  "description": "nralam.com — static site on GitHub Pages. Only the CSS has a build step.",
  "scripts": {
    "build": "npm run build:css && node scripts/bust.js",
    "build:css": "npx --yes tailwindcss@3.4.17 -i css/style.css -o css/style.min.css --minify",
    "watch:css": "npx --yes tailwindcss@3.4.17 -i css/style.css -o css/style.min.css --watch",
    "bust": "node scripts/bust.js"
  }
}
